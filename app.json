{
  "expo": {
    "name": "Memorize All",
    "slug": "memorize-all",
    "version": "0.1.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F7F5EF",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.seorilabs.memorizeall",
      "buildNumber": "2"
    },
    "android": {
      "predictiveBackGestureEnabled": true,
      "package": "com.seorilabs.memorizeall",
      "versionCode": 2
    },
    "web": {
      "favicon": "./assets/icon.png",
      "output": "single"
    },
    "plugins": [
      "expo-localization",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7F5EF",
          "image": "./assets/icon.png",
          "imageWidth": 120
        }
      ],
      "expo-router",
      "expo-system-ui"
    ],
    "extra": {
      "releaseChannel": "content-review",
      "publicBrandConfirmed": true
    },
    "scheme": "memorize-all"
  }
}
