{
  "name": "memorize-all",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.30",
    "expo-build-properties": "~57.0.22",
    "expo-constants": "~57.0.20",
    "expo-dev-client": "~57.0.20",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-linking": "~57.0.13",
    "expo-localization": "~57.0.2",
    "expo-router": "~57.0.28",
    "expo-sharing": "~57.0.23",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-google-mobile-ads": "^17.2.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test:core": "tsx --test tests/*.test.ts",
    "check:content": "tsx scripts/check-content.ts",
    "check:architecture": "tsx scripts/check-architecture.ts",
    "check:release": "tsx scripts/check-release.ts",
    "build:android:internal": "node scripts/build-android.mjs internal",
    "build:android:production": "node scripts/build-android.mjs production",
    "check": "npm run lint && npm run typecheck && npm run test:core && npm run test:content && npm run check:content && npm run check:architecture",
    "export:web": "expo export --platform web --output-dir dist/web",
    "export:native": "expo export --platform ios --platform android --output-dir dist/native",
    "lint": "eslint .",
    "format:check": "prettier --check src tests scripts/*.ts app.json package.json tsconfig.json eslint.config.js",
    "test:content": "python3 -m unittest discover -s tests -p test_*.py -v"
  },
  "private": true
}
